          }
        }
      ]
    },
    {
      "key": "nas-pribeh",
      "label": "Náš příběh",
      "hideable": true,
      "visible": true,
      "fields": [
        {
          "key": "t1",
          "type": "text",
          "label": "Nadtitulek",
          "value": "Náš příběh"
        },
        {
          "key": "t2",
          "type": "text",
          "label": "Nadpis",
          "value": "Z areálu Sázavanu do pražských hotelů i do zahraničí"
        },
        {
          "key": "t3",
          "type": "text",
          "label": "Text",
          "value": "Společnost CENTURY 2000 s.r.o. vznikla v roce 2000 v bývalém areálu Sázavan ve Zruči nad Sázavou. Od začátku se věnujeme šití bytových dekorací ve spolupráci s bytovými designéry a architekty."
        },
        {
          "key": "t4",
          "type": "text",
          "label": "Text",
          "value": "Postupně jsme rozšířili výrobu o hotelový program, strojní prošívání a prodej metráže. Dnes šijeme pro pětihvězdičkové hotely v Praze i pro zákazníky v Itálii, Německu, Anglii a Rakousku."
        },
        {
          "key": "t5",
          "type": "text",
          "label": "Doplnit",
          "value": "[DOPLNIT: 2–3 milníky s rokem, např. první hotelová zakázka, nový prošívací stroj]"
        }
      ]
    },
