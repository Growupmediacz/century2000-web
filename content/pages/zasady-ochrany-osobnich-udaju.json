        },
        {
          "key": "r3",
          "type": "rich",
          "label": "Buňka tabulky (desktop)",
          "value": "viz <a class=\"zasady-ochrany-osobnich-udaju__link\" href=\"/cookies/\">Zásady cookies</a>"
        },
        {
          "key": "t23",
          "type": "text",
          "label": "Nadpis",
          "value": "3. Kdo má k údajům přístup"
        },
        {
          "key": "r4",
          "type": "rich",
          "label": "Text",
          "value": "Údaje neprodáváme. Přístup k nim mohou mít jen naši dodavatelé, kteří nám pomáhají web a komunikaci provozovat: poskytovatel hostingu webu <mark class=\"todo zasady-ochrany-osobnich-udaju__note\">[DOPLNIT]</mark>, Microsoft (e-mail, Microsoft 365), Google (Google Analytics, jen se souhlasem) <mark class=\"todo zasady-ochrany-osobnich-udaju__note\">[DOPLNIT: další, např. účetní]</mark>."
        },
        {
          "key": "t24",
          "type": "text",
          "label": "Nadpis",
          "value": "4. Vaše práva"
        },
        {
          "key": "r5",
          "type": "rich",
          "label": "Text",
          "value": "Máte právo požádat o přístup ke svým údajům, jejich opravu nebo výmaz, omezení zpracování a přenositelnost. Můžete vznést námitku proti zpracování a kdykoli odvolat souhlas. Stačí napsat na <a class=\"zasady-ochrany-osobnich-udaju__link\" href=\"mailto:info@century2000.cz\">info@century2000.cz</a>."
        },
        {
          "key": "r6",
          "type": "rich",
          "label": "Text",
          "value": "Pokud se domníváte, že s údaji nezacházíme správně, můžete podat stížnost u Úřadu pro ochranu osobních údajů (<a class=\"zasady-ochrany-osobnich-udaju__link\" href=\"https://www.uoou.cz\" target=\"_blank\" rel=\"noopener\">www.uoou.cz</a>)."
        },
        {
          "key": "t25",
          "type": "text",
          "label": "Nadpis",
          "value": "5. Cookies"
        },
        {
          "key": "r7",
          "type": "rich",
          "label": "Text",
          "value": "Informace o cookies najdete v <a class=\"zasady-ochrany-osobnich-udaju__link\" href=\"/cookies/\">Zásadách cookies</a>."
        }
      ]
