    {
      "key": "blok-dekoracni-latky",
      "label": "Materiál: Dekorační látky",
      "hideable": true,
      "visible": true,
      "fields": [
        {
          "key": "t1",
          "type": "text",
          "label": "Mezititulek",
          "value": "Dekorační látky"
        },
        {
          "key": "r1",
          "type": "rich",
          "label": "Text (odstavce oddělte prázdným řádkem)",
          "value": "Dekorační látky nabízíme v metráži a šijeme z nich na míru závěsy, polštářky, ubrusy i další doplňky. Do polštářků nabízíme motivy se vzorem i čistě bílé, s výplní nebo prošívané.<br><br>Metráž můžete použít na závěsy, povlečení nebo ubrusy."
        },
        {
          "key": "t2",
          "type": "text",
          "label": "Odrážky (každá na nový řádek)",
          "value": ""
        }
      ]
    },
    {
      "key": "blok-nehorlave-latky",
      "label": "Materiál: Dekorační látky s nehořlavou úpravou",
      "hideable": true,
      "visible": true,
      "fields": [
        {
          "key": "t1",
          "type": "text",
          "label": "Mezititulek",
          "value": "Dekorační látky s nehořlavou úpravou"
        },
        {
          "key": "r1",
          "type": "rich",
          "label": "Text (odstavce oddělte prázdným řádkem)",
          "value": "Nabízíme dekorační látky o šířce 300 cm s uni vzorem nebo s vetkaným vzorem, ve široké škále barev.<br><br>Materiály jsou s nehořlavou úpravou a odpovídají evropským normám BS 5867 Part 2B, M1 a B1. Více v článku <a href=\"/clanky/nehorlave-dekoracni-latky-pro-hotely/\">Nehořlavé dekorační látky pro hotely a restaurace</a>."
