    {
      "key": "blok-4",
      "label": "Odstavec 4: Rouna a netkaná textilie",
      "hideable": true,
      "visible": true,
      "fields": [
        {
          "key": "t1",
          "type": "text",
          "label": "Mezititulek (H2)",
          "value": "Rouna a netkaná textilie"
        },
        {
          "key": "r1",
          "type": "rich",
          "label": "Text (odstavce oddělte prázdným řádkem)",
          "value": "Do proševu dodáváme polyesterové rouno v gramážích od 80 do 400 g a netkanou textilii v gramážích od 15 do 40 g. Rouna i textilie prodáváme také samostatně, viz <a href=\"/latky-a-metraz/#rouna\">Polyesterová rouna a netkané textilie</a>.<br><br>Vyšší gramáž rouna znamená objemnější, měkčí materiál. Správná volba závisí na tom, co z materiálu vznikne."
        },
        {
          "key": "t2",
          "type": "text",
          "label": "Odrážky (každá na nový řádek)",
          "value": ""
        }
      ]
