# Century 2000 – Apache (Webglobe)
DirectoryIndex index.php
Options -Indexes
AddDefaultCharset UTF-8
AddType font/woff2 .woff2
FileETag None

# Files that must never be downloaded (backups, logs, notes, configs)
<FilesMatch "(\.(bak|old|orig|swp|log|sql|sqlite|ini|md|sh|lock|dist|json|yml|yaml|env)|~)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # SSL certificate validation (Let's Encrypt) must stay reachable over HTTP
  RewriteRule ^\.well-known/acme-challenge/ - [L]

  # HTTPS everywhere (except the local dev server). Works on any domain, incl. the test domain.
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Uncomment on production (century2000.cz) to force www:
  # RewriteCond %{HTTP_HOST} ^century2000\.cz$ [NC]
  # RewriteRule ^ https://www.century2000.cz%{REQUEST_URI} [L,R=301]

  # Never serve app code, content, docs or config (when they live inside the web root)
  RewriteRule ^(app|content|tools|docs|vendor|node_modules)(/|$) - [F,L]
  RewriteRule ^config(\.example)?\.php$ - [F,L]
  RewriteRule (^|/)\. - [F,L]

  # BEGIN redirects (generated by tools/sync-redirects.php from app/redirects.php)
  RewriteRule ^siti-bytoveho-textilu/?$ /bytovy-textil-na-miru/ [R=301,L]
  RewriteRule ^siti-bytoveho-textilu/okenni-dekorace/?$ /bytovy-textil-na-miru/ [R=301,L]
  RewriteRule ^siti-bytoveho-textilu/potahy-na-zidle/?$ /bytovy-textil-na-miru/ [R=301,L]
  RewriteRule ^siti-bytoveho-textilu/prehozy-a-polstarky/?$ /bytovy-textil-na-miru/ [R=301,L]
  RewriteRule ^siti-bytoveho-textilu/rautove-sukne/?$ /hotelovy-textil/ [R=301,L]
  RewriteRule ^siti-bytoveho-textilu/vyroba-textilnich-vzorkovnic/?$ /vzorkovniky/ [R=301,L]
  RewriteRule ^siti-potahu-na-matrace/?$ /matracove-chranice-a-potahy/ [R=301,L]
  RewriteRule ^siti-potahu-na-matrace/matracove-chranice/?$ /matracove-chranice-a-potahy/ [R=301,L]
  RewriteRule ^siti-potahu-na-matrace/potahy-na-matrace-a-vyplne-polstaru/?$ /matracove-chranice-a-potahy/ [R=301,L]
  RewriteRule ^prosev-materialu/?$ /strojni-prosivani/ [R=301,L]
  RewriteRule ^prodej-metraze/?$ /latky-a-metraz/ [R=301,L]
  RewriteRule ^prodej-metraze/zaclony/?$ /latky-a-metraz/#zaclony [R=301,L,NE]
  RewriteRule ^prodej-metraze/ubrusoviny/?$ /latky-a-metraz/#ubrusoviny [R=301,L,NE]
  RewriteRule ^prodej-metraze/blackouty/?$ /latky-a-metraz/#blackouty [R=301,L,NE]
  RewriteRule ^prodej-metraze/dimouty/?$ /latky-a-metraz/#dimouty [R=301,L,NE]
  RewriteRule ^prodej-metraze/dekoracni-latky/?$ /latky-a-metraz/#dekoracni-latky [R=301,L,NE]
  RewriteRule ^prodej-metraze/dekoracni-latky-s-nehorlavou-upravou/?$ /latky-a-metraz/#nehorlave-latky [R=301,L,NE]
  RewriteRule ^prodej-metraze/polyesterova-rouna-a-netkane-textilie/?$ /latky-a-metraz/#rouna [R=301,L,NE]
  RewriteRule ^prodej-metraze/materialy-pro-vyrobu-potahu-na-matrace/?$ /latky-a-metraz/#materialy-na-potahy [R=301,L,NE]
  RewriteRule ^prodej-metraze/maloobchodni-prodej/?$ /latky-a-metraz/ [R=301,L]
  RewriteRule ^produkty/latky-na-ubrusy/?$ /clanky/latky-na-ubrusy-a-prostirani/ [R=301,L]
  RewriteRule ^e-shop/?$ https://century2000-cz.webnode.cz/ [R=301,L]
  # END redirects

  # Existing files and folders are served directly, everything else goes to index.php
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>

<IfModule mod_expires.c>
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # Basic CSP for static files. HTML pages send a stricter one from PHP (public_csp() in app/lib/tracking.php,
  # scripts only from this site and the measurement tools set in the admin; the admin has its own, strictest one).
  Header setifempty Content-Security-Policy "object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  # Browsers remember to use HTTPS only (sent only over HTTPS)
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
  Header unset X-Powered-By
  Header always unset X-Powered-By
</IfModule>
