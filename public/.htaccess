# Century 2000 – Apache (Webglobe)
DirectoryIndex index.php
Options -Indexes
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Uncomment on production to force HTTPS and www:
  # RewriteCond %{HTTPS} off [OR]
  # RewriteCond %{HTTP_HOST} !^www\. [NC]
  # RewriteRule ^ https://www.century2000.cz%{REQUEST_URI} [L,R=301]

  # Never serve app code, content or config (when they live inside the web root)
  RewriteRule ^(app|content|tools)(/|$) - [F,L]
  RewriteRule ^config(\.example)?\.php$ - [F,L]
  RewriteRule (^|/)\. - [F,L]

  # BEGIN redirects (generated by tools/sync-redirects.php from app/redirects.php)
  RewriteRule ^siti-bytoveho-textilu/?$ /bytovy-textil-na-miru/ [R=301,L]
  RewriteRule ^siti-bytoveho-textilu/okenni-dekorace/?$ /bytovy-textil-na-miru/ [R=301,L]
  RewriteRule ^siti-bytoveho-textilu/potahy-na-zidle/?$ /bytovy-textil-na-miru/ [R=301,L]
  RewriteRule ^siti-bytoveho-textilu/prehozy-a-polstarky/?$ /bytovy-textil-na-miru/ [R=301,L]
  RewriteRule ^siti-bytoveho-textilu/rautove-sukne/?$ /hotelovy-textil/ [R=301,L]
  RewriteRule ^siti-bytoveho-textilu/vyroba-textilnich-vzorkovnic/?$ /vzorkovniky/ [R=301,L]
  RewriteRule ^siti-potahu-na-matrace/?$ /matracove-chranice-a-potahy/ [R=301,L]
  RewriteRule ^siti-potahu-na-matrace/matracove-chranice/?$ /matracove-chranice-a-potahy/ [R=301,L]
  RewriteRule ^siti-potahu-na-matrace/potahy-na-matrace-a-vyplne-polstaru/?$ /matracove-chranice-a-potahy/ [R=301,L]
  RewriteRule ^prosev-materialu/?$ /strojni-prosivani/ [R=301,L]
  RewriteRule ^prodej-metraze/?$ /latky-a-metraz/ [R=301,L]
  RewriteRule ^prodej-metraze/zaclony/?$ /latky-a-metraz/#zaclony [R=301,L,NE]
  RewriteRule ^prodej-metraze/ubrusoviny/?$ /latky-a-metraz/#ubrusoviny [R=301,L,NE]
  RewriteRule ^prodej-metraze/blackouty/?$ /latky-a-metraz/#blackouty [R=301,L,NE]
  RewriteRule ^prodej-metraze/dimouty/?$ /latky-a-metraz/#dimouty [R=301,L,NE]
  RewriteRule ^prodej-metraze/dekoracni-latky/?$ /latky-a-metraz/#dekoracni-latky [R=301,L,NE]
  RewriteRule ^prodej-metraze/dekoracni-latky-s-nehorlavou-upravou/?$ /latky-a-metraz/#nehorlave-latky [R=301,L,NE]
  RewriteRule ^prodej-metraze/polyesterova-rouna-a-netkane-textilie/?$ /latky-a-metraz/#rouna [R=301,L,NE]
  RewriteRule ^prodej-metraze/materialy-pro-vyrobu-potahu-na-matrace/?$ /latky-a-metraz/#materialy-na-potahy [R=301,L,NE]
  RewriteRule ^prodej-metraze/maloobchodni-prodej/?$ /latky-a-metraz/ [R=301,L]
  RewriteRule ^produkty/latky-na-ubrusy/?$ /clanky/latky-na-ubrusy-a-prostirani/ [R=301,L]
  RewriteRule ^e-shop/?$ https://century2000-cz.webnode.cz/ [R=301,L]
  # END redirects

  # Existing files and folders are served directly, everything else goes to index.php
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
